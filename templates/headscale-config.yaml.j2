# Headscale Configuration for Nexus
# Documentation: https://headscale.net/

# server_url is provided via HEADSCALE_SERVER_URL environment variable
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: false

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: "nexus"
    region_name: "Nexus Headscale DERP"
    stun_listen_addr: "0.0.0.0:26478"
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 24h

disable_check_updates: true
node:
  ephemeral:
    inactivity_timeout: 30m

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

log:
  format: text
  level: info

policy:
  mode: file
  path: /etc/headscale/acl.hujson

dns:
  magic_dns: true
  base_domain: nexus.internal
  nameservers:
    global:
      - 1.1.1.1
      - 1.0.0.1
    split: {}
  search_domains: []
  extra_records: []

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

# OIDC (OpenID Connect) Authentication
# Uncomment and configure to enable browser-based login with Google, Authentik, etc.
# Redirect URI to configure in your IdP: https://headscale.<domain>/oidc/callback
oidc:
  only_start_if_oidc_is_available: false
  issuer: "https://auth.{{ nexus_domain }}/application/o/headscale/"
  # client_id and client_secret are provided securely via vault/env vars
  scope: ["openid", "profile", "email", "headscale-username"]
  allowed_users:
{% for group, emails in tailscale_users.items() %}
{% for email in emails %}
    - "{{ email }}"
{% endfor %}
{% endfor %}
