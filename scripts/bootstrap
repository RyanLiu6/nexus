#!/bin/bash
set -e

echo "🚀 Bootstrapping Nexus..."

# Detect OS
if [[ "$OSTYPE" == "darwin"* ]]; then
    OS="macos"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    OS="linux"
else
    echo "❌ Unsupported OS: $OSTYPE"
    exit 1
fi

echo "📦 Detected OS: $OS"

# Install uv if not found
if ! command -v uv &> /dev/null; then
    echo "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    source $HOME/.cargo/env
fi

# Install system dependencies
if [[ "$OS" == "macos" ]]; then
    if ! command -v brew &> /dev/null; then
        echo "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    if ! command -v ansible &> /dev/null; then
        echo "Installing ansible..."
        brew install ansible
    fi

    if ! command -v tofu &> /dev/null && ! command -v opentofu &> /dev/null; then
        echo "Installing opentofu..."
        brew install opentofu
    fi

    if ! command -v docker &> /dev/null; then
        echo "Installing Docker..."
        brew install --cask docker
        echo "Please open Docker Desktop to complete setup"
    fi
else
    sudo apt update
    sudo apt install -y ansible software-properties-common

    if ! command -v tofu &> /dev/null && ! command -v terraform &> /dev/null; then
        echo "Installing OpenTofu..."
        curl -fsSL https://get.opentofu.org/install-opentofu.sh | sudo sh -s -- --install-method deb
    fi

    if ! command -v docker &> /dev/null; then
        curl -fsSL https://get.docker.com | sh
        sudo usermod -aG docker "$USER"
    fi
fi

echo "Syncing dependencies..."
uv sync --all-extras

echo "Activating virtual environment..."
source .venv/bin/activate

echo "Installing pre-commit hooks..."
pre-commit install

echo "📂 Setting up data directories..."
DATA_DIR="${NEXUS_DATA_DIRECTORY:-$HOME/Data}"
echo "   Target: $DATA_DIR"
mkdir -p "$DATA_DIR"/{Config,Media,Backups}
echo "   ✅ Created Config, Media, Backups"

echo ""
echo "✅ Bootstrap complete!"
echo ""
echo "Next: Follow docs/DEPLOYMENT.md for the full setup guide."
echo ""
